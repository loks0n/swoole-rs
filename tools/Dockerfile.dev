# Build once; runs mount the checkout read-only and retain /work across containers.
FROM rust:1.97-bookworm
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    php-dev php-sqlite3 php-curl php-mbstring libclang-dev libpcre2-dev libssl-dev \
    pkg-config python3 python3-pytest autoconf make g++ git ca-certificates \
    cmake libgtest-dev libnghttp2-dev libpq-dev libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*
RUN rustup component add rustfmt clippy
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ccache php-redis redis-server locales \
    && localedef -i en_US -f ISO-8859-1 en_US.ISO8859-1 \
    && localedef -i tr_TR -f ISO-8859-9 tr_TR.ISO8859-9 \
    && localedef -i tr_TR -f UTF-8 tr_TR.UTF-8 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
