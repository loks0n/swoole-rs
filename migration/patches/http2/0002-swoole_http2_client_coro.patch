+        nvs[i].flags = NGHTTP2_NV_FLAG_NO_COPY_NAME | NGHTTP2_NV_FLAG_NO_COPY_VALUE;
+    }
+    size_t bound = nghttp2_hd_deflate_bound(codec, nvs.data(), count);
+    zend_string *block = zend_string_alloc(bound, 0);
+    *result = nghttp2_hd_deflate_hd(codec, (uint8_t *) ZSTR_VAL(block), bound, nvs.data(), count);
+    if (*result < 0) {
+        zend_string_free(block);
+        return nullptr;
+    }
+    ZSTR_LEN(block) = *result;
+    ZSTR_VAL(block)[*result] = '\0';
