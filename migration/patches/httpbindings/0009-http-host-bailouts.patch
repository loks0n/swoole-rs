+++ b/ext-src/php_swoole_http.h
@@ -381,2 +381,20 @@ static sw_inline zval *swoole_http_init_and_read_property(
 
+/**
+ * A swr_http_host_ call that can run user code (a header value's __toString,
+ * exit() in it) runs `body` here: a bailout is trapped and reported, and the
+ * Rust caller re-raises it once its own frames are done (docs/zend.md).
+ */
+template <typename F>
+static inline bool swr_http_host_try(F &&body) {
+    bool bailed = false;
+    zend_try {
+        body();
+    }
+    zend_catch {
+        bailed = true;
+    }
+    zend_end_try();
+    return bailed;
+}
