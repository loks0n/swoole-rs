+
+// What crates/phpclients' methods need from the C++ coroutine socket: one call
+// per operation (native/clients/swoole_rs_phpclients.h).
+static SocketImpl *socket_of(void *socket) {
+    return static_cast<SocketImpl *>(socket);
+}
+
+void swoole_rs_php_error(int level, bool fatal, const char *message) {
+    if (fatal) {
+        php_swoole_fatal_error(level, "%s", message);
+    } else {
+        php_swoole_error(level, "%s", message);
+    }
+}
+
+void swoole_socket_coro_unconstructed(void) {
+    swoole_fatal_error(SW_ERROR_WRONG_OPERATION, "must call constructor first");
+}
+
+void *swoole_socket_coro_create(int64_t domain, int64_t type, int64_t protocol, int *error) {
+    php_swoole_check_reactor();
+    auto *socket = new SocketImpl((int) domain, (int) type, (int) protocol);
+    if (UNEXPECTED(socket->get_fd() < 0)) {
+        *error = errno;
+        delete socket;
+        return nullptr;
+    }
+    return socket;
+}
+
+void swoole_socket_coro_init(zend_object *object) {
+    zval zobject;
+    ZVAL_OBJ(&zobject, object);
+    socket_coro_init(&zobject, socket_coro_fetch_object(object));
+}
+
+/**
+ * cannot execute close in the destructor, it may be shutting down,
+ * executing close will try to resume other coroutines.
+ */
+void swoole_socket_coro_release(zend_object *object) {
+    auto *sock = socket_coro_fetch_object(object);
+    if (!sock->reference && sock->socket) {
+        if (!Z_ISUNDEF(sock->zstream)) {
+            sock->socket->move_fd();
+            zval_ptr_dtor(&sock->zstream);
+        }
+        delete sock->socket;
+    }
+}
+
+void swoole_socket_coro_close(zend_object *object) {
+    auto *sock = socket_coro_fetch_object(object);
+    if (sock->socket->protocol.private_data_1) {
+        sw_callable_free(sock->socket->protocol.private_data_1);
+        sock->socket->protocol.private_data_1 = nullptr;
+    }
+    if (!Z_ISUNDEF(sock->zstream)) {
+        php_stream *stream = nullptr;
+        php_stream_from_zval_no_verify(stream, &sock->zstream);
+        if (stream != nullptr) {
+            /* close & destroy stream, incl. removing it from the rsrc list;
+             * resource stored in php_sock->zstream will become invalid */
+            php_stream_free(stream,
+                            PHP_STREAM_FREE_KEEP_RSRC | PHP_STREAM_FREE_CLOSE |
+                                (stream->is_persistent ? PHP_STREAM_FREE_CLOSE_PERSISTENT : 0));
+        }
+        ZVAL_UNDEF(&sock->zstream);
+        sock->socket->move_fd();
+    } else {
+        sock->socket->close();
+    }
+}
+
+bool swoole_socket_coro_is_closed(void *socket) {
+    return socket_of(socket)->is_closed();
+}
+
+int swoole_socket_coro_error(void *socket, const char **message) {
+    *message = socket_of(socket)->errMsg;
+    return socket_of(socket)->errCode;
+}
+
+void swoole_socket_coro_set_error(void *socket, int code, const char *message) {
+    socket_of(socket)->set_err(code, std::string(message));
+}
