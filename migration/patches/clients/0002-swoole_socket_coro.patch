+char *swoole_socket_coro_pop_packet(void *socket) {
+    char *packet = socket_of(socket)->pop_packet();
+    if (packet == nullptr) {
+        socket_of(socket)->set_err(ENOMEM);
+    }
+    return packet;
+}
+
+ssize_t swoole_socket_coro_vector(
+    void *socket, int op, struct iovec *vectors, int count, double timeout, int *index, size_t *offset) {
+    auto *sock = socket_of(socket);
+    swoole::network::IOVector io_vector(vectors, count);
+    SocketImpl::TimeoutSetter ts(sock, timeout, op < 2 ? SW_TIMEOUT_READ : SW_TIMEOUT_WRITE);
+    ssize_t retval;
+    switch (op) {
+    case 0:
+        retval = sock->readv(&io_vector);
+        break;
+    case 1:
+        retval = sock->readv_all(&io_vector);
+        break;
+    case 2:
+        retval = sock->writev(&io_vector);
+        break;
+    default:
+        retval = sock->writev_all(&io_vector);
+        break;
+    }
+    *index = io_vector.get_index();
+    *offset = io_vector.get_offset_bytes();
+    return retval;
+}
