+
+void *swoole_socket_coro_accept(void *socket, double timeout) {
+    SocketImpl *conn = socket_of(socket)->accept(timeout);
+    // It must be copied once to avoid destroying the function when the connection closes.
+    if (conn && socket_of(socket)->protocol.private_data_1) {
+        auto *cb = static_cast<zend::Callable *>(socket_of(socket)->protocol.private_data_1);
+        conn->protocol.private_data_1 = cb->dup();
+    }
+    return conn;
+}
