+
+ssize_t swoole_socket_coro_transfer(void *socket, int op, char *buffer, size_t length, double timeout) {
+    auto *sock = socket_of(socket);
+    if (op == 0) {
+        return sock->peek(buffer, length);
+    }
+    SocketImpl::TimeoutSetter ts(sock, timeout, op < 5 ? SW_TIMEOUT_READ : SW_TIMEOUT_WRITE);
+    switch (op) {
+    case 1:
+        return sock->recv(buffer, length);
+    case 2:
+        return sock->recv_all(buffer, length);
+    case 3:
+        return sock->recv_line(buffer, length);
+    case 4:
+        return sock->recv_with_buffer(buffer, length);
+    case 5:
+        return sock->send(buffer, length);
+    default:
+        return sock->send_all(buffer, length);
+    }
+}
+
+ssize_t swoole_socket_coro_recv_packet(void *socket, double timeout) {
+    ssize_t retval = socket_of(socket)->recv_packet(timeout);
+    if (retval == 0) {
+        socket_of(socket)->get_read_buffer()->clear();
+    }
+    return retval;
+}
