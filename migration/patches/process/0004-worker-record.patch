diff --git a/src/server/process.cc b/src/server/process.cc
index 829e58a..e68d6f7 100644
--- a/src/server/process.cc
+++ b/src/server/process.cc
@@ -21,2 +21,12 @@ namespace swoole {
 
+// Rust owns the Worker record layout (crates/process/src/worker_record.rs, mirrored by
+// swr_v1_worker_record). Lock swoole::Worker to it so a drift fails this build, not the
+// sw_shm-backed worker array at runtime. The scalar process fields migrate behind
+// accessors; see #629.
+static_assert(sizeof(Worker) == sizeof(swr_v1_worker_record), "Worker layout drift (size)");
+static_assert(offsetof(Worker, pid) == offsetof(swr_v1_worker_record, pid), "Worker.pid drift");
+static_assert(offsetof(Worker, id) == offsetof(swr_v1_worker_record, id), "Worker.id drift");
+static_assert(offsetof(Worker, status) == offsetof(swr_v1_worker_record, status), "Worker.status drift");
+static_assert(offsetof(Worker, type) == offsetof(swr_v1_worker_record, kind), "Worker.type drift");
+
 // The Server's Rust-owned worker registry (pid -> Worker*).
