--- a/ext-src/swoole_thread.cc
+++ b/ext-src/swoole_thread.cc
@@ -155,2 +155,131 @@ static const zend_function_entry swoole_thread_methods[] = {
 
+#ifdef SWOOLE_SOCKETS_SUPPORT
+void php_swoole_thread_php_socket_create(zval *return_value, zend_long sockfd);
+
+static int thread_host_php_socket_cast(zval *zvalue) {
+    php_socket *php_sock = SW_Z_SOCKET_P(zvalue);
+    if (php_sock->bsd_socket == -1) {
+        zend_throw_exception(swoole_exception_ce, "invalid socket fd", EBADF);
+        return -2;
+    }
+    int fd = dup(php_sock->bsd_socket);
+    if (fd == -1) {
+        zend_throw_exception(swoole_exception_ce, "failed to dup socket fd", errno);
+    }
+    return fd;
+}
+#endif
+
+// What crates/phpthread reaches of C++: serialization, sockets, and the Lock,
+// Atomic and Barrier resources a container may hold.
+static swr_v1_phpthread_host thread_host = {
+    nullptr,
+    [](zval *value, bool *bailed) -> zend_string * {
+        zend_string *result = nullptr;
+        *bailed = false;
+        zend_try {
+            result = php_swoole_serialize(value);
+        }
+        zend_catch {
+            *bailed = true;
+        }
+        zend_end_try();
+        return result;
+    },
+    [](const char *data, size_t length, zval *out) -> bool {
+        bool bailed = false;
+        zend_string *serialized = zend_string_init(data, length, false);
+        zend_try {
+            php_swoole_unserialize(serialized, out);
+        }
+        zend_catch {
+            bailed = true;
+        }
+        zend_end_try();
+        zend_string_release(serialized);
+        return bailed;
+    },
+    [](zval *zvalue) -> uint32_t {
+        if (sw_zval_is_co_socket(zvalue)) {
+            return IS_CO_SOCKET;
+        }
+#ifdef SWOOLE_SOCKETS_SUPPORT
+        if (sw_zval_is_php_socket(zvalue)) {
+            return IS_PHP_SOCKET;
+        }
+#endif
+        zend_class_entry *ce = Z_OBJCE_P(zvalue);
+        if (instanceof_function(ce, swoole_thread_lock_ce)) {
+            return IS_LOCK;
+        } else if (instanceof_function(ce, swoole_thread_atomic_ce)) {
+            return IS_ATOMIC;
+        } else if (instanceof_function(ce, swoole_thread_atomic_long_ce)) {
+            return IS_ATOMIC_LONG;
+        } else if (instanceof_function(ce, swoole_thread_barrier_ce)) {
+            return IS_BARRIER;
+        }
+        return 0;
+    },
+    [](zval *zvalue, uint32_t kind) -> void * {
+        switch (kind) {
+        case IS_LOCK:
+            return php_swoole_thread_lock_cast(zvalue);
+        case IS_ATOMIC:
+            return php_swoole_thread_atomic_cast(zvalue);
+        case IS_ATOMIC_LONG:
+            return php_swoole_thread_atomic_long_cast(zvalue);
+        default:
+            return php_swoole_thread_barrier_cast(zvalue);
+        }
+    },
+    [](zval *return_value, uint32_t kind, void *resource) {
+        auto r = static_cast<ThreadResource *>(resource);
+        switch (kind) {
+        case IS_LOCK:
+            php_swoole_thread_lock_create(return_value, r);
+            break;
+        case IS_ATOMIC:
+            php_swoole_thread_atomic_create(return_value, r);
+            break;
+        case IS_ATOMIC_LONG:
+            php_swoole_thread_atomic_long_create(return_value, r);
+            break;
+        default:
+            php_swoole_thread_barrier_create(return_value, r);
+            break;
+        }
+    },
+    [](void *resource) { static_cast<ThreadResource *>(resource)->add_ref(); },
+    [](void *resource) { static_cast<ThreadResource *>(resource)->del_ref(); },
+    php_swoole_thread_stream_cast,
+    [](zval *zvalue, int *type) -> int {
+        swSocketType socket_type{};
+        int fd = php_swoole_thread_co_socket_cast(zvalue, &socket_type);
+        *type = socket_type;
+        return fd;
+    },
+#ifdef SWOOLE_SOCKETS_SUPPORT
+    thread_host_php_socket_cast,
+#else
+    nullptr,
+#endif
+    [](zval *return_value, int64_t fd) { php_swoole_thread_stream_create(return_value, fd); },
+    [](zval *return_value, int64_t fd, int type) {
+        php_swoole_thread_co_socket_create(return_value, fd, (swSocketType) type);
+    },
+#ifdef SWOOLE_SOCKETS_SUPPORT
+    [](zval *return_value, int64_t fd) { php_swoole_thread_php_socket_create(return_value, fd); },
+#else
+    nullptr,
+#endif
+    [](int error) { swoole_set_last_error(error); },
+    [](bool list) {
+        if (list) {
+            swoole_fatal_error(SW_ERROR_WRONG_OPERATION, "must call constructor first");
+        } else {
+            php_swoole_fatal_error(E_ERROR, "must call constructor first");
+        }
+    },
+};
