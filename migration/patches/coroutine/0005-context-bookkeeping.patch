diff --git a/include/swoole_coroutine_context.h b/include/swoole_coroutine_context.h
index 25df2c1de..d8c60a728 100644
--- a/include/swoole_coroutine_context.h
+++ b/include/swoole_coroutine_context.h
@@ -20,2 +20,9 @@
 #include "swoole.h"
+#ifdef SWOOLE_RS_COROUTINE
+#include "swoole_rs_coroutine.h"
+static_assert(sizeof(swr_v1_context_stack_cell) == sizeof(char *) && alignof(swr_v1_context_stack_cell) == alignof(char *) &&
+              sizeof(swr_v1_context_extent) == sizeof(uint32_t) && alignof(swr_v1_context_extent) == alignof(uint32_t) &&
+              sizeof(bool) == 1 && alignof(bool) == 1 && sizeof(swr_v1_context_completion) == 1 && alignof(swr_v1_context_completion) == 1,
+              "Context bookkeeping requires exact Native cell ABI");
+#endif
 
@@ -67,3 +74,7 @@ class Context {
     char *get_stack() const {
+#ifdef SWOOLE_RS_COROUTINE
+        return static_cast<char *>(swr_v1_context_stack_read(&stack_, &stack_size_).pointer);
+#else
         return stack_;
+    #endif
     }
@@ -71,3 +82,7 @@ class Context {
     size_t get_stack_size() const {
+#ifdef SWOOLE_RS_COROUTINE
+        return swr_v1_context_stack_read(&stack_, &stack_size_).size;
+#else
         return stack_size_;
+    #endif
     }
@@ -75,3 +90,7 @@ class Context {
     bool is_end() const {
+#ifdef SWOOLE_RS_COROUTINE
+        return swr_v1_context_completed(&end_);
+#else
         return end_;
+    #endif
     }
@@ -87,2 +106,6 @@ class Context {
     coroutine_context_t swap_ctx_;
+#ifdef SWOOLE_RS_COROUTINE
+    swr_v1_context_stack_cell stack_;
+    swr_v1_context_extent stack_size_;
+#else
     char *stack_;
@@ -90,2 +113,3 @@ class Context {
 #endif
+#endif
 #ifdef USE_VALGRIND
@@ -94,3 +118,7 @@ class Context {
     void *private_data_;
+#ifdef SWOOLE_RS_COROUTINE
+    swr_v1_context_completion end_;
+#else
     bool end_;
+#endif
 
diff --git a/src/coroutine/thread_context.cc b/src/coroutine/thread_context.cc
index ec55b8ba8..e5161700d 100644
--- a/src/coroutine/thread_context.cc
+++ b/src/coroutine/thread_context.cc
@@ -64,3 +64,7 @@ Context::Context(size_t stack_size, CoroutineFunc fn, void *private_data)
     : fn_(std::move(fn)), private_data_(private_data) {
+#ifdef SWOOLE_RS_COROUTINE
+    swr_v1_context_prepare(&end_, nullptr);
+#else
     end_ = false;
+#endif
     lock_.lock();
@@ -98,3 +102,7 @@ void Context::context_func(coroutine_transfer_t arg) {
     _this->fn_(_this->private_data_);
+#ifdef SWOOLE_RS_COROUTINE
+    swr_v1_context_finish(&_this->end_);
+#else
     _this->end_ = true;
+#endif
     current_lock = _this->swap_lock_;
