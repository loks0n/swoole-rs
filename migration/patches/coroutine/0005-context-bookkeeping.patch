+    Coroutine::CancelFunc cancel_fn = [call](Coroutine *co) {
+        swr_v1_channel_waiter(call->chan->producer_queue.native_handle(),
+                              call->chan->consumer_queue.native_handle(),
+                              SWR_CH_WAITER_REMOVE, call->type, co);
         co->resume();
