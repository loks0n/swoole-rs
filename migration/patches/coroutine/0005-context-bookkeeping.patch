+// The per-operation native context a whole pop/push/close calls back into: the
+// coroutine, its timeout message and role. The step machine owns the queues and
+// decides; these effects suspend, resume and drive the timer.
+struct ChannelCall {
+    Channel *chan;
+    Coroutine *co;
+    Channel::TimeoutMessage msg;
+    Channel::Opcode type;
+    double timeout;
+};
+}  // namespace
+
+uint32_t Channel::rs_query(void *context) {
+    auto *call = static_cast<ChannelCall *>(context);
+    return (call->co->is_canceled() ? SWR_CH_CANCELED : 0u) | (call->msg.error ? SWR_CH_TIMEDOUT : 0u);
+}
+
+void Channel::rs_arm_timer(void *context) {
+    auto *call = static_cast<ChannelCall *>(context);
+    call->msg.timer = swoole_timer_add(call->timeout, false, Channel::timer_callback, &call->msg);
+}
+
+void Channel::rs_delete_timer(void *context) {
+    swoole_timer_del(static_cast<ChannelCall *>(context)->msg.timer);
