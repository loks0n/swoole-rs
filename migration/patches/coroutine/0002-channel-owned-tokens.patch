         return data_queue.size();
+    #endif
     }
@@ -89,3 +125,7 @@ class Channel {
     size_t consumer_num() const {
+#ifdef SWOOLE_RS_COROUTINE
+        return view().consumers;
+#else
         return consumer_queue.size();
+    #endif
     }
@@ -93,3 +133,7 @@ class Channel {
     size_t producer_num() const {
+#ifdef SWOOLE_RS_COROUTINE
+        return view().producers;
+#else
         return producer_queue.size();
+    #endif
     }
@@ -97,2 +141,5 @@ class Channel {
     void *pop_data() {
+#ifdef SWOOLE_RS_COROUTINE
+        return swr_v1_channel_pop_data(data_queue.native_handle());
+#else
         if (data_queue.empty()) {
@@ -103,2 +150,3 @@ class Channel {
         return data;
+    #endif
     }
@@ -106,3 +154,7 @@ class Channel {
