+    }
+#endif
 
@@ -130,2 +199,14 @@ class Channel {
     Coroutine *pop_coroutine(Opcode type) {
+#ifdef SWOOLE_RS_COROUTINE
+        const auto plan = swr_v1_channel_waiter(producer_queue.native_handle(), consumer_queue.native_handle(),
+                                              SWR_CH_WAITER_POP, type, nullptr);
+        if (plan.status != 0) abort();
+        auto *co = static_cast<Coroutine *>(plan.token);
+        if (plan.role == PRODUCER) {
+            swoole_trace_log(SW_TRACE_CHANNEL, "resume producer cid=%ld", co->get_cid());
+        } else {
+            swoole_trace_log(SW_TRACE_CHANNEL, "resume consumer cid=%ld", co->get_cid());
+        }
+        return co;
+#else
         Coroutine *co;
