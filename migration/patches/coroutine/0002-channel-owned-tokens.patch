   protected:
+#ifdef SWOOLE_RS_COROUTINE
+    swr_v1_channel_state state_;
+#else
     size_t capacity = 1;
@@ -113,2 +168,8 @@ class Channel {
     int error_ = 0;
+#endif
+#ifdef SWOOLE_RS_COROUTINE
+    ChannelTokens<Coroutine *> producer_queue;
+    ChannelTokens<Coroutine *> consumer_queue;
+    ChannelTokens<void *> data_queue;
+#else
     std::list<Coroutine *> producer_queue;
@@ -116,2 +177,10 @@ class Channel {
     std::queue<void *> data_queue;
+#endif
+
+#ifdef SWOOLE_RS_COROUTINE
