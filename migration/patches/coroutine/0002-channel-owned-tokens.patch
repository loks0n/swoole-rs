@@ -25,2 +25,5 @@
 #include <queue>
+#ifdef SWOOLE_RS_COROUTINE
+#include "swoole_rs_channel_tokens.h"
+#endif
 
@@ -28,2 +31,15 @@ namespace swoole {
 namespace coroutine {
+#ifdef SWOOLE_RS_COROUTINE
+// Exact qualified scalar prefix. Queue members retain their existing offsets.
+struct ChannelNativeScalarLayout { size_t capacity; bool closed; int error; };
+static_assert(sizeof(size_t) == 8 && sizeof(void *) == 8 && sizeof(bool) == 1 && sizeof(int) == 4,
+              "Channel Rust metadata requires qualified 64-bit scalar ABI");
+static_assert(sizeof(swr_v1_channel_state) == 16 && alignof(swr_v1_channel_state) == 8 &&
+              sizeof(swr_v1_channel_state) == sizeof(ChannelNativeScalarLayout) &&
+              alignof(swr_v1_channel_state) == alignof(ChannelNativeScalarLayout) &&
+              offsetof(swr_v1_channel_state, capacity) == offsetof(ChannelNativeScalarLayout, capacity) &&
+              offsetof(swr_v1_channel_state, closed) == offsetof(ChannelNativeScalarLayout, closed) &&
+              offsetof(swr_v1_channel_state, error) == offsetof(ChannelNativeScalarLayout, error),
+              "Channel Rust metadata prefix ABI");
+#endif
 //-------------------------------------------------------------------------------
@@ -55,3 +71,7 @@ class Channel {
 
+#ifdef SWOOLE_RS_COROUTINE
+    explicit Channel(size_t _capacity = 1) : state_(swr_v1_channel_state_new(_capacity)) {}
+#else
     explicit Channel(size_t _capacity = 1) : capacity(_capacity) {}
+#endif
 
@@ -73,3 +93,7 @@ class Channel {
     bool is_closed() const {
