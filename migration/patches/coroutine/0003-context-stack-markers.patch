 ssize_t Context::get_stack_usage() {
+    return swr_v1_context_stack_step(&stack_, &stack_size_, SWR_CTX_STACK_USAGE, nullptr, 0).size;
+}
+#else
+ssize_t Context::get_stack_usage() {
+#ifdef SWOOLE_RS_COROUTINE
+    return swr_v1_context_stack_usage(reinterpret_cast<const uint8_t *>(stack_), stack_size_);
+#else
     size_t offset = START_OFFSET;
