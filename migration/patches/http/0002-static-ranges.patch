+    if (!capacity || swr_v2_http_context_text(context_, SWR_HTTP_CONTEXT_FILENAME,
+            reinterpret_cast<uint8_t *>(output), capacity - 1, &length) < 0 || length >= capacity)
+        throw std::length_error("Invalid HTTP filename copy");
+    output[length] = 0;
