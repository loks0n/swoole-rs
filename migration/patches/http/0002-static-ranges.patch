+bool StaticHandler::stat_file() {
+    char filename[PATH_MAX]; copy_filename(filename,sizeof(filename));
+    struct stat value;
+    if (lstat(filename,&value) != 0) return false;
+    swr_v2_http_observation facts{};
+    facts.filesize=value.st_size;
+#ifdef __MACH__
+    facts.mtime=value.st_mtimespec.tv_sec;
+#else
+    facts.mtime=value.st_mtim.tv_sec;
+#endif
+    facts.kind=(S_ISDIR(value.st_mode) ? uint32_t(SWR_HTTP_PATH_IS_DIRECTORY) : 0u) |
+        (S_ISREG(value.st_mode) ? uint32_t(SWR_HTTP_PATH_FILE) : 0u) |
+        (S_ISLNK(value.st_mode) ? uint32_t(SWR_HTTP_PATH_LINK) : 0u);
+    if (swr_v2_http_context_observed(context_,0,&facts) < 0) throw std::logic_error("Invalid HTTP stat");
     return true;
