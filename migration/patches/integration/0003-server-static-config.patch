+    int32_t action = static_files().root_begin(path.length(), PATH_MAX);
+    if (action == SWR_HTTP_CONFIG_ROOT_WARN_LENGTH) {
+        swoole_error_log(
+            SW_LOG_WARNING, SW_ERROR_NAME_TOO_LONG, "The length of document_root must be less than %d", PATH_MAX);
+        return false;
+    }
+    char _realpath[PATH_MAX];
+    const char *canonical = realpath(path.c_str(), _realpath);
+    action = static_files().root_finish(canonical);
+    if (action == SWR_HTTP_CONFIG_ROOT_WARN_DIRECTORY) {
+        swoole_error_log(SW_LOG_WARNING, SW_ERROR_DIR_NOT_EXIST, "document_root[%s] does not exist", path.c_str());
+        return false;
+    }
+    return true;
+}
