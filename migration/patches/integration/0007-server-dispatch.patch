+            swoole_set_last_error(errno);
+            delete port;
+            ctx->port = nullptr;
+            return 0;
+        }
+        return 1;
+    case SWR_SERVER_OP_NEW_PORT_TYPE:
+        return port->type;
+    case SWR_SERVER_OP_DGRAM_PORT:
+        // dgram socket, setting socket buffer size
+        port->socket->set_buffer_size(port->socket_buffer_size);
+        serv->have_dgram_sock = true;
+        serv->dgram_port_num++;
+        if (arg == SW_SOCK_UDP) {
+            serv->udp_socket_ipv4 = port->socket;
+        } else if (arg == SW_SOCK_UDP6) {
+            serv->udp_socket_ipv6 = port->socket;
+        } else {
+            serv->dgram_socket = port->socket;
+        }
+        return 0;
+    case SWR_SERVER_OP_STREAM_PORT:
+        serv->have_stream_sock = true;
+        return 0;
+    case SWR_SERVER_OP_PORT_PUSH:
+        serv->ports.push_back(port);
+        port->object_id = serv->ports.size();
+        return 0;
+    case SWR_SERVER_OP_ENV_LISTEN_PID:
+    case SWR_SERVER_OP_ENV_FDS_START: {
+        int value;
+        if (!swoole_get_env(op == SWR_SERVER_OP_ENV_LISTEN_PID ? "LISTEN_PID" : "LISTEN_FDS_START", &value)) {
+            return (uint64_t) INT64_MIN;
+        }
+        return (int64_t) value;
+    }
+    case SWR_SERVER_LOG_LISTEN_PID:
+        swoole_warning("invalid LISTEN_PID");
+        return 0;
+    case SWR_SERVER_LOG_FDS_START:
+        swoole_warning("invalid LISTEN_FDS_START");
+        return 0;
+    case SWR_SERVER_OP_SYSTEMD_FDS:
+        return (int64_t) swoole_get_systemd_listen_fds();
+    case SWR_SERVER_OP_PORT_IMPORT: {
+        auto *ls = new ListenPort(serv);
+        if (!ls->import((int) arg)) {
+            delete ls;
+            return 0;
+        }
+        // O_NONBLOCK & O_CLOEXEC
+        ls->socket->set_fd_option(1, 1);
+        ctx->port = ls;
+        return 1;
+    }
     default:
