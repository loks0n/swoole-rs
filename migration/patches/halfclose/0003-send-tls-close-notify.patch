diff --git a/src/network/socket.cc b/src/network/socket.cc
index ed3945714..7bf2a5596 100644
--- a/src/network/socket.cc
+++ b/src/network/socket.cc
@@ -759,2 +759,5 @@ int Socket::handle_sendfile() {
     ssize_t rv = sendfile(task->file, &task->begin, sendn);
+    if (rv < 0 && errno == EINTR) {
+        return SW_OK;
+    }
 
@@ -1525,7 +1528,4 @@ bool Socket::ssl_shutdown() {
 
-    int mode = SSL_get_shutdown(ssl);
-    SSL_set_shutdown(ssl, mode | SSL_RECEIVED_SHUTDOWN | SSL_SENT_SHUTDOWN);
-
+    ssl_clear_error();
     int n = SSL_shutdown(ssl);
-    ssl_closed_ = 1;
     swoole_trace("SSL_shutdown: %d", n);
@@ -1534,3 +1534,3 @@ bool Socket::ssl_shutdown() {
     /* before 0.9.8m SSL_shutdown() returned 0 instead of -1 on errors */
-    if (n != 1 && ERR_peek_error()) {
+    if (n < 0) {
         sslerr = SSL_get_error(ssl, n);
@@ -1539,2 +1539,6 @@ bool Socket::ssl_shutdown() {
 
+    ssl_want_read = sslerr == SSL_ERROR_WANT_READ;
+    ssl_want_write = sslerr == SSL_ERROR_WANT_WRITE;
+    ssl_closed_ = !(ssl_want_read || ssl_want_write);
+
     if (!(n == 1 || sslerr == 0 || sslerr == SSL_ERROR_ZERO_RETURN)) {
@@ -1542,3 +1546,4 @@ bool Socket::ssl_shutdown() {
         const char *error_string = ssl_get_error_reason(&reason);
-        swoole_warning("SSL_shutdown() failed, reason=%d, error_string=%s", reason, error_string);
+        swoole_warning("SSL_shutdown() failed, reason=%d, error_string=%s",
+                       reason, error_string ? error_string : "no OpenSSL reason available");
         return false;
