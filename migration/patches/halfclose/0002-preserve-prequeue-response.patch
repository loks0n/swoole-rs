diff --git a/src/server/reactor_thread.cc b/src/server/reactor_thread.cc
--- a/src/server/reactor_thread.cc
+++ b/src/server/reactor_thread.cc
@@ -177,6 +177,22 @@
         conn->timer = nullptr;
     }
 
+    if (socket->ssl && socket->ssl_state == SW_SSL_STATE_READY && socket->is_stream() &&
+        !(conn->peer_closed || conn->close_force || conn->close_reset) && !socket->ssl_closed_ &&
+        !socket->ssl_shutdown() && (socket->ssl_want_read || socket->ssl_want_write)) {
+        if (!conn->close_queued) {
+            if (!socket->out_buffer) {
+                socket->out_buffer = new Buffer(SW_SEND_BUFFER_SIZE);
