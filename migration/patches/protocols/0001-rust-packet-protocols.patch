+}
+void MessageBus::PacketPool::insert(uint64_t id, std::shared_ptr<String> value) {
+    auto holder = std::make_unique<PacketHolder>(std::move(value));
+    if (!index_) {
+        index_ = swr_v1_bus_pool_create();
+        if (!index_) throw std::bad_alloc();
+    }
+    const swr_bus_pool_entry entry{id, reinterpret_cast<uintptr_t>(holder.get())};
+    const uintptr_t lookup = reinterpret_cast<uintptr_t>(holder->get());
+    if (swr_v1_bus_pool_insert_values(index_, &entry, &lookup, 1) != 0) {
+        throw std::bad_alloc();
+    }
