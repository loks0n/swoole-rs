+                holders[i] = std::make_unique<PacketHolder>(*reinterpret_cast<PacketHolder *>(entries[i].token));
+                entries[i].token = reinterpret_cast<uintptr_t>(holders[i].get());
+                lookups[i] = reinterpret_cast<uintptr_t>(holders[i]->get());
+            }
+            if (swr_v1_bus_pool_insert_values(index_, entries, lookups, count) != 0) throw std::bad_alloc();
+            for (size_t i = 0; i < count; ++i) holders[i].release();
+            offset += count;
+        }
+    } catch (...) {
+        clear();
+        swr_v1_bus_pool_release(index_);
+        throw;
+    }
+}
+MessageBus::PacketPool &MessageBus::PacketPool::operator=(const PacketPool &other) {
+    PacketPool copy(other);
+    std::swap(index_, copy.index_);
