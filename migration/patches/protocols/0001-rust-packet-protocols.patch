+void MessageBus::PacketPool::clear() {
+    uintptr_t tokens[32];
+    while (auto count = swr_v1_bus_pool_drain(index_, tokens, 32)) {
+        for (size_t i = 0; i < count; ++i) delete reinterpret_cast<PacketHolder *>(tokens[i]);
+    }
+}
+size_t MessageBus::PacketPool::memory_size() const {
+    size_t result = 0;
+    swr_bus_pool_entry entries[32];
+    size_t offset = 0;
+    while (auto count = swr_v1_bus_pool_snapshot(index_, offset, entries, 32)) {
+        for (size_t i = 0; i < count; ++i) result += (*reinterpret_cast<PacketHolder *>(entries[i].token))->size;
+        offset += count;
     }
+    return result;
