diff --git a/src/lock/coroutine_lock.cc b/src/lock/coroutine_lock.cc
--- a/src/lock/coroutine_lock.cc
+++ b/src/lock/coroutine_lock.cc
@@ -17,2 +17,3 @@
 #include "swoole_lock.h"
+#include "swoole_rs_locks.h"

@@ -59,3 +60,3 @@

-    if (*value == 0) {
+    if (swr_v1_locks_coroutine_release((uint32_t *) value) == 0) {
         return 0;
@@ -63,3 +64,2 @@

-    *value = 0;
     cid = 0;
@@ -81,5 +81,7 @@

-    if (current_coroutine == static_cast<Coroutine *>(coroutine) && current_coroutine->get_cid() == cid) {
-        return 0;
-    }
+    // Snapshot the original one-time reentrancy check across native suspension.
+    const uintptr_t held_cookie = reinterpret_cast<uintptr_t>(coroutine);
+    const int64_t held_cid = cid;
+    const uintptr_t current_cookie = reinterpret_cast<uintptr_t>(current_coroutine);
+    const int64_t current_cid = current_coroutine->get_cid();

@@ -91,9 +93,7 @@
     while (true) {
-        if (sw_atomic_cmp_set(value, 0, 1)) {
-            break;
-        }
-
-        if (!blocking) {
-            return EBUSY;
-        }
+        const int action = swr_v1_locks_coroutine_try((uint32_t *) value, held_cookie, held_cid,
+                                                     current_cookie, current_cid, blocking);
+        if (action == 0) { return 0; }
+        if (action == 1) { break; }
+        if (action == 2) { return EBUSY; }

@@ -110,4 +110,3 @@
         // will make it increasingly difficult to acquire the lock.
-        second = (second >= SW_FILE_LOCK_MAX_SECOND) ? SW_FILE_LOCK_DEFAULT_SECOND
-                                                     : SW_MIN(second * 2, SW_FILE_LOCK_MAX_SECOND);
+        second = swr_v1_locks_coroutine_backoff(second, SW_FILE_LOCK_DEFAULT_SECOND, SW_FILE_LOCK_MAX_SECOND);
 #endif
