+#error "Reactor overlay requires --enable-swoole-rs-reactor"
+#endif
 #include "swoole_signal.h"
@@ -34,2 +37,26 @@ using network::Socket;
 
+// Native signal/function-pointer/log effects only, after each Rust decision.
+// The handler is observed in original short-circuit order; no post-effect read.
+static void swr_reactor_dispatch_signal(Signal *signal_data) {
+    swr_v1_reactor_signal_state state{};
+    int observed = 0;
+    for (;;) {
+        switch (swr_v1_reactor_signal_workflow(&state, observed)) {
+        case 0: return;
+        case 1: signal_data->handler(signal_data->signo); return;
+        case 2:
+            swoole_error_log(SW_LOG_WARNING,
+                            SW_ERROR_UNREGISTERED_SIGNAL,
+                            SW_UNREGISTERED_SIGNAL_FMT,
+                            swoole_signal_to_str(signal_data->signo));
+            return;
+        case 10: observed = signal_data->activated; break;
+        case 11: observed = signal_data->handler != nullptr; break;
+        case 12: observed = signal_data->handler != SIG_IGN; break;
+        default: std::abort();
+        }
+    }
+}
+
