+// Native signal/function-pointer/log effects only, after each Rust decision.
+// The handler is observed in original short-circuit order; no post-effect read.
+static void swr_reactor_dispatch_signal(Signal *signal_data) {
+    swr_v1_reactor_signal_state state{};
+    int observed = 0;
+    for (;;) {
+        switch (swr_v1_reactor_signal_workflow(&state, observed)) {
+        case 0: return;
+        case 1: signal_data->handler(signal_data->signo); return;
+        case 2:
