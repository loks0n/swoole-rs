+// Native effects only; the synchronous callback remains outside every Rust
+// frame. File offset facts are requested only after its actual send returns.
+template<class Effect>
+static ReturnCode swr_socket_blocking_io(Socket *socket, uint32_t kind, size_t length, ssize_t &bytes,
+                                         const Effect &effect, off_t *offset = nullptr, off_t end = 0, int flags = 0) {
+    uint32_t phase = 0;
+    ssize_t result = 0;
+    int observed = 0;
+    int64_t begin_fact = flags, end_fact = 0;
+    for (;;) {
+        auto reply = swr_v1_reactor_blocking_io(kind, phase, length, bytes, result, observed, begin_fact, end_fact);
+        phase = reply.phase;
+        switch (reply.action) {
+        case 0: return static_cast<ReturnCode>(reply.value);
+        case 1: result = effect(reply.offset, reply.length, reply.value); break;
+        case 2: observed = errno; break;
+        case 3: observed = socket->catch_error(errno); break;
+        case 4: swoole_set_last_error(errno); break;
+        case 5: bytes = reply.value; break;
+        case 6: begin_fact = *offset; end_fact = end; break;
+        default: std::abort();
+        }
+    }
 }
