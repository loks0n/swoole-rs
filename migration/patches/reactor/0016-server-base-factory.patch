+Factory *Server::create_base_factory() {
+    BaseFactoryContext ctx{this};
+    // The connection list is private to the server.
+    auto call = [](void *c, uint32_t op, uint64_t arg) {
+        Server *serv = static_cast<BaseFactoryContext *>(c)->serv;
+        switch (op) {
+        case SWR_SERVER_OP_ALLOC_CONNECTIONS:
+            serv->connection_list = static_cast<Connection *>(sw_calloc(serv->max_connection, sizeof(Connection)));
+            return (uint64_t) (serv->connection_list != nullptr);
+        case SWR_SERVER_LOG_BASE_ALLOC_CONNECTIONS:
+            swoole_sys_warning("calloc[2](%zu) failed", serv->max_connection * sizeof(Connection));
+            return (uint64_t) 0;
+        default:
+            return base_factory_call(c, op, arg);
+        }
+    };
+    return base_factory_run(SWR_SERVER_RUN_BASE_CREATE, 0, &ctx, call) ? ctx.created : nullptr;
