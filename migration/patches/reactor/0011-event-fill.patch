@@ -303,2 +304,19 @@ Reactor::Reactor(int max_event, Type _type) {
 
+static_assert(sizeof(Event) == sizeof(swr_v1_reactor_event) && offsetof(Event, fd) == offsetof(swr_v1_reactor_event, fd) &&
+                  offsetof(Event, reactor_id) == offsetof(swr_v1_reactor_event, reactor_id) &&
+                  offsetof(Event, type) == offsetof(swr_v1_reactor_event, type) &&
+                  offsetof(Event, socket) == offsetof(swr_v1_reactor_event, socket) && sizeof(FdType) == sizeof(int),
+              "the Rust wait loop fills swoole::Event");
+
+const swr_v1_reactor_socket_fields *Reactor::socket_fields() {
+    static const swr_v1_reactor_socket_fields fields{
+        [](void *socket) { return static_cast<Socket *>(socket)->fd; },
+        [](void *socket) { return static_cast<int>(static_cast<Socket *>(socket)->fd_type); },
+        [](void *socket) { return static_cast<Socket *>(socket)->events; },
+        [](void *socket) { return static_cast<bool>(static_cast<Socket *>(socket)->removed); },
+        [](void *socket) { static_cast<Socket *>(socket)->event_hup = 1; },
+    };
+    return &fields;
+}
